# Cloudflare Pages. dist HAS a 404.html (vite-plugins/not-found-page.ts), so the
# built-in spa fallback is OFF: every router path must be rewritten here
# (__tests__/not-found-page.spec.ts checks it). Rules here win over real files: never add a /* splat. Rewrite to / (not
# /index.html, which pages flags as an infinite loop and ignores).
/terms-of-service.html /terms 301
/terms-of-service /terms 301
/privacy-policy.html /privacy 301
/privacy-policy /privacy 301
/security-policy.html /terms 301
/security-policy /terms 301
# 301s go before the rewrites (first match wins). /guide canonicalizes to the
# guides index (trailing slash matches the sitemap). Other trailing-slash
# router paths go to the slashless route. Never redirect /guide/ : that path
# is a real file (guide/index.html), and a rule here would beat the file.
/guide /guide/ 301
/leaderboard /leaderboards 301
/leaderboard/ /leaderboards 301
/verify/ /verify 301
/leaderboards/ /leaderboards 301
# /about is the old SPA shell. The crawlable about page is /guide/about.
/about /guide/about 301
/about/ /guide/about 301
# old kids slug. 301 forever to the indexable parents/teachers guide.
/guide/typing-for-kids /guide/teaching-kids-to-type 301
/guide/typing-for-kids/ /guide/teaching-kids-to-type 301
/guide/teaching-kids-to-type/ /guide/teaching-kids-to-type 301
/settings/ /settings 301
/login/ /login 301
/account/ /account 301
/account-settings/ /account-settings 301
/profile/ /profile 301
/race/ /race 301
/friends/ /friends 301
/verify / 200
/leaderboards / 200
/settings / 200
/login / 200
/account / 200
/account-settings / 200
/profile / 200
/profile/* / 200
/race / 200
/r/* / 200
/friends / 200
