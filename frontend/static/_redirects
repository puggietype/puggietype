# Cloudflare Pages. dist HAS a 404.html (vite-plugins/not-found-page.ts), so the
# built-in spa fallback is OFF: every router path must be rewritten here
# (__tests__/not-found-page.spec.ts checks it). Rules here win over real files: never add a /* splat. Rewrite to / (not
# /index.html, which pages flags as an infinite loop and ignores).
/terms-of-service.html /terms 301
/terms-of-service /terms 301
/privacy-policy.html /privacy 301
/privacy-policy /privacy 301
/security-policy.html /terms 301
/security-policy /terms 301
/verify / 200
/leaderboards / 200
/about / 200
/settings / 200
/login / 200
/account / 200
/account-settings / 200
/profile / 200
/profile/* / 200
/race / 200
/r/* / 200
/friends / 200
