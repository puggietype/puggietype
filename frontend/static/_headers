# Cloudflare Pages response headers. The CSP placeholders (inline-script
# hashes, WS origin) are filled in at build time by vite-plugins/pages-headers.ts.
# That step also appends kids-guide rules: detach this CSP, then set one
# policy with no Analytics, Tag Manager, or ads hosts. Pages comma-joins a
# repeated CSP, so those paths must not inherit this header.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' __SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' __WS_ORIGIN__ https://poetrydb.org https://*.wikipedia.org; media-src 'self' blob:; worker-src 'self'; manifest-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/js/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

# fonts keep their filename forever (a changed font gets a new name)
/webfonts/*
  Cache-Control: public, max-age=31536000, immutable

# images aren't content-hashed (pug frames are swapped in place): a month
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# background music files aren't content-hashed either: a month, like images
/music/*
  Cache-Control: public, max-age=2592000

# html: always revalidate so a deploy shows up at once. Only the pages, not
# /*, because cloudflare joins the values of every rule that matches.
/
  Cache-Control: public, max-age=0, must-revalidate

/guide/*
  Cache-Control: public, max-age=0, must-revalidate

/faq
  Cache-Control: public, max-age=0, must-revalidate

/contact
  Cache-Control: public, max-age=0, must-revalidate

/privacy
  Cache-Control: public, max-age=0, must-revalidate

/terms
  Cache-Control: public, max-age=0, must-revalidate

/ads.txt
  Content-Type: text/plain; charset=utf-8

# indexnow key (scripts/indexnow-ping.mjs)
/0ee4e9e83d311fae5b2a9062e73dcb43.txt
  Content-Type: text/plain; charset=utf-8

/robots.txt
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/version.json
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache
